generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model Blog {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  description     String?
  content         String?
  published       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  thumbnailUrl    String?
  author          String?
  canonicalUrl    String?
  category        String?
  metaDescription String?
  metaTitle       String?
  publishedAt     DateTime?
  tags            String[]  @default([])

  @@index([published, publishedAt])
  @@index([category])
}

model Product {
  id                String        @id @default(cuid())
  name              String
  slug              String        @unique
  price             Int
  imageUrl          String?
  published         Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tag               String?
  contraindications Json?
  indications       Json?
  ingredients       Json?
  gallery           Json?
  shortDescription  String?
  directionsToUse   Json?
  medicineForm      MedicineForm?
  packaging         Json?

  @@index([published])
  @@index([name])
}

model MarqueeItem {
  id        String   @id @default(cuid())
  text      String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  password   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  role       Role      @default(VIEWER)
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  name       String?
  leads      Lead[]    @relation("UserLeads")
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  ip        String?
  userAgent String?
  createdAt DateTime   @default(now())
  claimedAt DateTime?
  ownerId   String?
  status    LeadStatus @default(NEW)
  city      String?
  owner     User?      @relation("UserLeads", fields: [ownerId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  actorId     String
  action      String
  entityType  String
  entityId    String?
  ip          String?
  userAgent   String?
  metadata    Json     @default("{}")
  entityLabel String?

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

enum MedicineForm {
  TABLET
  CAPSULE
  SYRUP
  DROPS
  SUSPENSION
  POWDER
  GRANULES
  OINTMENT
  CREAM
  GEL
  LOTION
  SHAMPOO
  OIL
  SPRAY
  INHALER
  INJECTION
  OTHER
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CONVERTED
  LOST
}

enum Role {
  VIEWER
  SALES
  ADMIN
}
