generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL") // Accelerate
  directUrl = env("DATABASE_URL")        // Direct DB for migrations
}

model Blog {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String?
  content      String?
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  thumbnailUrl String?
}

enum MedicineForm {
  TABLET
  CAPSULE
  SYRUP
  DROPS
  SUSPENSION
  POWDER
  GRANULES
  OINTMENT
  CREAM
  GEL
  LOTION
  SHAMPOO
  OIL
  SPRAY
  INHALER
  INJECTION
  OTHER
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique

  tag              String?

  // ✅ pricing
  price            Int

  // ✅ description
  shortDescription String?

  // ✅ images
  imageUrl         String?  // cover image
  gallery          Json?    // ["url1", "url2", ...]

  // ✅ dosage form
  medicineForm     MedicineForm?

  // ✅ packaging info based on form (kept flexible)
  packaging        Json?    // { tabletsPerStrip, stripsPerBox } / { bottleMl } / { tubeGm } etc

  // ✅ brochure style sections
  indications       Json?
  ingredients       Json?
  directionsToUse   Json?
  contraindications Json?

  published        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([published])
  @@index([name])
}



model MarqueeItem {
  id        String   @id @default(cuid())
  text      String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @default(VIEWER)
}

model Lead {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())
  done      Boolean   @default(false)
  doneAt    DateTime?
}

model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String
  action     String
  entityType String
  entityId   String?
  ip         String?
  userAgent  String?
  metadata   Json     @default("{}")

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}
