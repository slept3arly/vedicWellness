generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model Blog {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  description     String?
  content         String?
  published       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  thumbnailUrl    String?
  author          String?
  canonicalUrl    String?
  category        String?
  metaDescription String?
  metaTitle       String?
  publishedAt     DateTime?
  tags            String[]  @default([])

  @@index([published, publishedAt])
  @@index([category])
}

model Company {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([active])
}

model Product {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  companyId         String
  subtitle          String?

  /* Pricing */
  price             Int
  compareAtPrice    Int?
  currency          String   @default("INR")

  /* Inventory */
  sku               String?  @unique
  stock             Int      @default(0)

  /* Media */
  imageUrl          String?
  gallery           String[] @default([])

  /* Core Descriptions */
  shortDescription  String?
  longDescription   String?

  /* Structured Content */
  highlights        String[] @default([])   // Amazon bullets
  benefits          String[] @default([])   // Icon feature grid
  whoShouldUse      String[] @default([])

  ingredients       String[] @default([])
  directionsToUse   String[] @default([])
  precautions       String[] @default([])
  packaging         String[] @default([])

  /* Technical Info */
  manufacturer      String?
  countryOfOrigin   String?
  shelfLife         String?
  netQuantity       String?

  /* Trust Layer */
  trustBadges       String[] @default([])
  certifications    String[] @default([])

  /* Categorization */
  tag               String?
  medicineForm      MedicineForm?

  /* Status */
  published         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  /* Relations */
  cartItems         CartItem[]
  variants          ProductVariant[]
  specifications    ProductSpecification[]
  faqs              ProductFAQ[]
  reviews           ProductReview[]
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  /* Indexes (Aligned With Your Existing Strategy) */
  @@index([published])
  @@index([name])
  @@index([published, tag])
  @@index([published, medicineForm])
  @@index([published, createdAt])
  @@index([companyId, published])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  name       String        // e.g. "Pack of 3"
  price      Int
  compareAtPrice Int?
  stock      Int      @default(0)
  sku        String?  @unique

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSpecification {
  id         String   @id @default(cuid())
  productId  String
  label      String
  value      String

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductFAQ {
  id         String   @id @default(cuid())
  productId  String
  question   String
  answer     String

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  rating     Int
  title      String?
  comment    String?
  createdAt  DateTime @default(now())

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model MarqueeItem {
  id        String   @id @default(cuid())
  text      String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  ip        String?
  userAgent String?
  createdAt DateTime   @default(now())
  claimedAt DateTime?
  ownerId   String?
  status    LeadStatus @default(NEW)
  city      String?
  owner     User?      @relation("UserLeads", fields: [ownerId], references: [id])

  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  actorId     String
  action      String
  entityType  String
  entityId    String?
  ip          String?
  userAgent   String?
  metadata    Json     @default("{}")
  entityLabel String?

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  password String
  name     String?
  phone    String?

  role       Role      @default(VIEWER)
  verified   Boolean   @default(false)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  addresses Address[]
  cart      Cart?
  orders    Order[]
  leads     Lead[]    @relation("UserLeads")

  @@index([deletedAt, createdAt])
}

model Address {
  id     String @id @default(cuid())
  userId String

  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String  @default("India")

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, isDefault])
}

model Cart {
  id     String @id @default(cuid())
  userId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]
  user  User @relation(fields: [userId], references: [id])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model Order {
  id     String @id @default(cuid())
  userId String

  status OrderStatus @default(CREATED)

  totalAmount Int
  currency    String @default("INR")

  shippingName  String
  shippingPhone String
  shippingAddr  Json

  paymentProvider String?
  paymentOrderId  String?
  paymentId       String?
  paidAt          DateTime?

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]
  user  User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
  @@index([userId, status])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String

  productId   String?
  productName String
  price       Int
  quantity    Int

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Slide {
  id                String           @id @default(cuid())
  imageDesktopUrl   String
  imageMobileUrl    String

  placements        SlidePlacement[]

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model SlidePlacement {
  id           String        @id @default(cuid())

  slide        Slide         @relation(fields: [slideId], references: [id], onDelete: Cascade)
  slideId      String

  placementKey PlacementKey
  order        Int           @default(0)

  isActive     Boolean       @default(true)

  startAt      DateTime?
  endAt        DateTime?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([placementKey])
  @@index([startAt, endAt])
}

model Banner {
  id          String   @id @default(cuid())

  /* Banner Mode */
  type        BannerType @default(TEXT)

  /* Text Content */
  title       String?
  message     String?

  /* Visual */
  imageUrl    String?     // background OR full image banner

  /* CTA */
  buttonText  String?
  buttonLink  String?

  /* Control */
  isActive    Boolean  @default(true)

  /* Scheduling */
  startAt     DateTime?
  endAt       DateTime?

  /* Metadata */
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([startAt, endAt])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  optedIn   Boolean  @default(true)
  source    String?  // homepage, blog, footer etc
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BannerType {
  IMAGE_ONLY
  TEXT
}

enum PlacementKey {
  HOME_HERO
  HOME_SECONDARY
  BLOGS_TOP
  CATEGORY_TOP
  FESTIVAL_BANNER
}


enum OrderStatus {
  CREATED
  PAYMENT_FAILED
  PAID
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

enum MedicineForm {
  TABLET
  CAPSULE
  SYRUP
  DROPS
  SUSPENSION
  POWDER
  GRANULES
  OINTMENT
  CREAM
  GEL
  LOTION
  SHAMPOO
  OIL
  SPRAY
  INHALER
  INJECTION
  OTHER
}

enum LeadStatus {
  NEW
  HOT
  WARM
  CONVERTED
  LOST
  USELESS
}

enum Role {
  VIEWER
  SALES
  ADMIN
}
