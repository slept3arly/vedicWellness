generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model Blog {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  description     String?
  content         String?
  published       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  thumbnailUrl    String?
  author          String?
  canonicalUrl    String?
  category        String?
  metaDescription String?
  metaTitle       String?
  publishedAt     DateTime?
  tags            String[]  @default([])

  @@index([published, publishedAt])
  @@index([category])
}

model Product {
  id                String        @id @default(cuid())
  name              String
  slug              String        @unique
  price             Int
  imageUrl          String?
  published         Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tag               String?
  contraindications Json?
  indications       Json?
  ingredients       Json?
  gallery           Json?
  shortDescription  String?
  directionsToUse   Json?
  medicineForm      MedicineForm?
  packaging         Json?

  cartItems CartItem[]

  @@index([published])
  @@index([name])
}

model MarqueeItem {
  id        String   @id @default(cuid())
  text      String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  ip        String?
  userAgent String?
  createdAt DateTime   @default(now())
  claimedAt DateTime?
  ownerId   String?
  status    LeadStatus @default(NEW)
  city      String?
  owner     User?      @relation("UserLeads", fields: [ownerId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  actorId     String
  action      String
  entityType  String
  entityId    String?
  ip          String?
  userAgent   String?
  metadata    Json     @default("{}")
  entityLabel String?

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  password String
  name     String?
  phone    String?

  role       Role      @default(VIEWER)
  verified   Boolean   @default(false)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?   // ⭐ ADD THIS
  
  addresses Address[]
  cart      Cart?
  orders    Order[]
  leads     Lead[]    @relation("UserLeads")
}

model Address {
  id     String @id @default(cuid())
  userId String

  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String  @default("India")

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Cart {
  id     String @id @default(cuid())
  userId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]
  user  User @relation(fields: [userId], references: [id])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Order {
  id     String @id @default(cuid())
  userId String

  status OrderStatus @default(CREATED)

  totalAmount Int
  currency    String @default("INR")

  shippingName  String
  shippingPhone String
  shippingAddr  Json

  paymentProvider String?
  paymentOrderId  String?
  paymentId       String?
  paidAt          DateTime?

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]
  user  User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String

  productId   String?
  productName String
  price       Int
  quantity    Int

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Slide {
  id                String           @id @default(cuid())
  imageDesktopUrl   String
  imageMobileUrl    String

  placements        SlidePlacement[]

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model SlidePlacement {
  id           String        @id @default(cuid())

  slide        Slide         @relation(fields: [slideId], references: [id], onDelete: Cascade)
  slideId      String

  placementKey PlacementKey
  order        Int           @default(0)

  isActive     Boolean       @default(true)

  startAt      DateTime?
  endAt        DateTime?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([placementKey])
  @@index([startAt, endAt])
}

enum PlacementKey {
  HOME_HERO
  HOME_SECONDARY
  BLOGS_TOP
  CATEGORY_TOP
  FESTIVAL_BANNER
}


enum OrderStatus {
  CREATED
  PAYMENT_FAILED
  PAID
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

enum MedicineForm {
  TABLET
  CAPSULE
  SYRUP
  DROPS
  SUSPENSION
  POWDER
  GRANULES
  OINTMENT
  CREAM
  GEL
  LOTION
  SHAMPOO
  OIL
  SPRAY
  INHALER
  INJECTION
  OTHER
}

enum LeadStatus {
  NEW
  HOT
  WARM
  CONVERTED
  LOST
  USELESS
}

enum Role {
  VIEWER
  SALES
  ADMIN
}
